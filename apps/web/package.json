{
  "name": "@group-interview-arena/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "uv run --project ../api python ../api/tests/integration/browser_e2e.py && uv run --project ../api python ../api/tests/integration/p1_6d_final_acceptance_e2e.py",
    "test:e2e:browser": "playwright test e2e/auth.spec.ts e2e/session.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript http://localhost:8000/openapi.json --output src/lib/api/generated/schema.d.ts",
    "api:check": "openapi-typescript http://localhost:8000/openapi.json --output src/lib/api/generated/schema.d.ts --check"
  },
  "dependencies": {
    "next": "16.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
