# Environment variable template for Group Interview Arena.
# Never place real secrets in this file or commit a populated `.env` file.

# P0-3E local FastAPI settings. CORS remains disabled unless explicitly set.
GIA_API_ENVIRONMENT=development
GIA_API_LOG_LEVEL=INFO
GIA_API_CORS_ORIGINS=["http://localhost:3000"]

# Public browser configuration. Never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
