# Copy to deploy/beta/.env and replace every CHANGE_ME value locally.
# The real .env is ignored by Git and must never be committed.

GIA_IMAGE_TAG=local

# Browser-visible value. It is embedded into the Next.js bundle at image build time.
NEXT_PUBLIC_API_BASE_URL=https://api.beta.lijingai.com

# Caddy production sites. Leave BETA_CADDY_TLS empty for public ACME TLS.
BETA_WEB_SITE=beta.lijingai.com
BETA_API_SITE=api.beta.lijingai.com
BETA_CADDY_TLS=
CADDY_ACME_EMAIL=CHANGE_ME_operator_email@example.com

# PostgreSQL values. URL-encode reserved characters in GIA_API_DATABASE_URL.
POSTGRES_DB=group_interview_arena_beta
POSTGRES_USER=gia_beta
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password
GIA_API_DATABASE_URL=postgresql+psycopg://gia_beta:CHANGE_ME_url_encoded_password@postgres:5432/group_interview_arena_beta

# Exact first-party browser origin shared by CORS, CSRF and WebSocket validation.
GIA_API_CORS_ORIGINS=["https://beta.lijingai.com"]
GIA_API_LOG_LEVEL=INFO

# Server-only provider configuration. Never use NEXT_PUBLIC_ for these values.
GIA_API_ZHIPU_API_KEY=CHANGE_ME_server_only_provider_key
GIA_API_ZHIPU_MODEL=glm-4.7-flashx

